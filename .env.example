# Neon connection string (Dashboard → Connection details → "Connection string", pooled is fine)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Long random string used to sign session cookies
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Optional: TURN relay for strict networks
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional: extra allowed origin (e.g. http://localhost:5173 is allowed automatically in dev)
CLIENT_ORIGIN=
# Optional: YouTube Data API v3 key - Chill Room finds the full-length song for each track you add
YOUTUBE_API_KEY=
